rules_version = '2';

// Registro do aceite dos Termos de Uso e da Política de Privacidade (RN15).
// Só o próprio usuário lê e cria o seu documento; ninguém altera ou apaga
// pelo app. Os campos precisam bater com FirestoreConsentService.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role',
             'legal_docs_version', 'consent_accepted_at', 'created_at', 'platform'])
        && request.resource.data.role == 'guardian'
        && request.resource.data.consent_accepted_at == request.time;
      allow update, delete: if false;
    }
  }
}
